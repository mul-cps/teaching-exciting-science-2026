+CallbackReturn FeetechHardwareInterface::load_state_mapping_() {
+  state_mapping_by_id_.clear();
+  if (!read_only_) {
+    return CallbackReturn::SUCCESS;
+  }
+
+  const auto mapping_it = info_.hardware_parameters.find("state_mapping_file");
+  if (mapping_it == info_.hardware_parameters.end() || mapping_it->second.empty()) {
+    return CallbackReturn::SUCCESS;
+  }
+
+  try {
+    const YAML::Node root = YAML::LoadFile(mapping_it->second);
+    const YAML::Node joints = root["joints"];
+    if (!joints || !joints.IsMap()) {
+      spdlog::error("state_mapping_file '{}' has no top-level joints map", mapping_it->second);
+      return CallbackReturn::ERROR;
+    }
+
+    const double radians_per_raw_count = root["radians_per_raw_count"].as<double>();
+    if (!std::isfinite(radians_per_raw_count) || radians_per_raw_count <= 0.0) {
+      spdlog::error("state_mapping_file '{}' has invalid radians_per_raw_count", mapping_it->second);
+      return CallbackReturn::ERROR;
+    }
+    if (root["qualified"] && !root["qualified"].as<bool>()) {
+      spdlog::warn("state_mapping_file '{}' is unqualified; converted states are provisional",
+                   mapping_it->second);
+    }
+
+    for (auto it = joints.begin(); it != joints.end(); ++it) {
+      const std::string joint_name = it->first.as<std::string>();
+      const YAML::Node entry = it->second;
+      if (!entry.IsMap() || !entry["servo_id"]) {
+        spdlog::error("state_mapping_file joint '{}' has no servo_id", joint_name);
+        return CallbackReturn::ERROR;
+      }
+
+      const int servo_id = entry["servo_id"].as<int>();
+      JointStateMapping mapping{.software_zero_raw = std::nullopt,
+                                .radians_per_raw_count = radians_per_raw_count};
+      if (entry["software_zero_raw"]) {
+        mapping.software_zero_raw = entry["software_zero_raw"].as<double>();
+        if (!std::isfinite(*mapping.software_zero_raw)) {
+          spdlog::error("state_mapping_file joint '{}' has invalid software_zero_raw", joint_name);
+          return CallbackReturn::ERROR;
+        }
+      } else if (entry["mapping"] && entry["mapping"].as<std::string>() == "normalized_fraction_only") {
+        spdlog::warn(
+            "state_mapping_file joint '{}' provides normalized_fraction_only jaw data; leaving it on the "
+            "native STS midpoint conversion (unqualified angular state)",
+            joint_name);
+      }
+      if (!state_mapping_by_id_.emplace(servo_id, mapping).second) {
+        spdlog::error("state_mapping_file has duplicate servo_id {}", servo_id);
+        return CallbackReturn::ERROR;
+      }
+    }
+  } catch (const YAML::Exception& e) {
+    spdlog::error("Failed to load state_mapping_file '{}': {}", mapping_it->second, e.what());
+    return CallbackReturn::ERROR;
+  } catch (const std::exception& e) {
+    spdlog::error("Invalid state_mapping_file '{}': {}", mapping_it->second, e.what());
+    return CallbackReturn::ERROR;
+  }
+
+  return CallbackReturn::SUCCESS;
+}
