+// Pure predicate: reject unavailable texture samples without clamping UVs.
+static inline bool texture_sample_offset(float u, float v, int width, int height,
+                                         int stride, int channels, size_t storage, size_t& offset)
+{
+    if (!std::isfinite(u) || !std::isfinite(v) || u < 0.f || u >= 1.f || v < 0.f || v >= 1.f ||
+        width <= 0 || height <= 0 || stride <= 0 || channels <= 0 || channels > 4 ||
+        size_t(width) > size_t(stride) / size_t(channels) ||
+        size_t(height) > storage / size_t(stride))
+        return false;
+    // Preserve the original float product; reject rounding to width/height.
+    const float x = u * width;
+    const float y = v * height;
+    if (x < 0 || double(x) >= width || y < 0 || double(y) >= height)
+        return false;
+    const int pixx = static_cast<int>(x);
+    const int pixy = static_cast<int>(y);
+    if (pixx < 0 || pixx >= width || pixy < 0 || pixy >= height)
+        return false;
+    // Storage bounds precede every multiplication/addition used for indexing.
+    offset = size_t(pixy) * size_t(stride);
+    if (size_t(pixx) > (storage - offset) / size_t(channels))
+        return false;
+    offset += size_t(pixx) * size_t(channels);
+    return size_t(channels) <= storage - offset;
+}
