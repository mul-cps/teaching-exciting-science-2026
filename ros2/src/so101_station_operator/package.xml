<?xml version="1.0"?>
<package format="3">
  <name>so101_station_operator</name><version>0.1.0</version>
  <description>Measured-state RViz station operator panel and bounded ROS operation adapter.</description>
  <maintainer email="cps@example.invalid">CPS station maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rviz_common</depend><depend>pluginlib</depend><depend>rclcpp</depend>
  <depend>std_srvs</depend><depend>std_msgs</depend>
