# Preparation-only original-color parents; no executable object admission.
set(PARENT_SHADER_DIR "${CMAKE_CURRENT_BINARY_DIR}/parent-shaders")
set(PRECOMPILED_PARENT_SHADER_DIR "" CACHE PATH "Hash-validated offline U32 original-parent SPIR-V")
file(MAKE_DIRECTORY "${PARENT_SHADER_DIR}")
# Preserve mtimes when identity is unchanged: reconfiguration is not compilation.
function(parent_write_stable PATH CONTENT)
 if(EXISTS "${PATH}")
  file(READ "${PATH}" PREVIOUS)
  if(PREVIOUS STREQUAL CONTENT)
   return()
  endif()
 endif()
 file(WRITE "${PATH}" "${CONTENT}")
endfunction()
set(PARENT_IDENTITY "${CMAKE_CURRENT_BINARY_DIR}/parent-build-identity.txt")
set(PARENT_PENDING_PROVENANCE "${CMAKE_CURRENT_BINARY_DIR}/parent-provenance.pending")
set(PARENT_PENDING_SOURCE "${CMAKE_CURRENT_BINARY_DIR}/parent-source.pending")
file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/shaders/parents.slang" PARENT_HASH)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/shaders/parents.slang")
set(PARENT_FLAGS "-entry <entry> -stage compute -target spirv -profile sm_6_0 -fp-mode precise -O2")
if(PRECOMPILED_PARENT_SHADER_DIR)
 file(READ "${PRECOMPILED_PARENT_SHADER_DIR}/source.sha256" PARENT_EXPECTED_SOURCE)
 file(READ "${PRECOMPILED_PARENT_SHADER_DIR}/provenance.txt" PARENT_PROVENANCE)
 if(NOT PARENT_EXPECTED_SOURCE STREQUAL "${PARENT_HASH}\n")
  message(FATAL_ERROR "Offline parent source or SPIR-V digest mismatch")
 endif()
 foreach(REQUIRED_LINE "source_sha256=${PARENT_HASH}\n" "parents.slang=${PARENT_HASH}\n" "flags=${PARENT_FLAGS}\n" "compiler=" "version=" "compiler_sha256=")
  string(FIND "${PARENT_PROVENANCE}" "${REQUIRED_LINE}" PARENT_POSITION)
  if(PARENT_POSITION EQUAL -1)
   message(FATAL_ERROR "Offline parent missing matching provenance: ${REQUIRED_LINE}")
  endif()
 endforeach()
 file(SHA256 "${PRECOMPILED_PARENT_SHADER_DIR}/provenance.txt" PARENT_CACHE_PROVENANCE_HASH)
 parent_write_stable("${PARENT_IDENTITY}" "mode=offline
cache=${PRECOMPILED_PARENT_SHADER_DIR}
provenance_sha256=${PARENT_CACHE_PROVENANCE_HASH}
${PARENT_PROVENANCE}")
else()
 if(NOT EXISTS "${SLANGC_EXECUTABLE}")
  message(FATAL_ERROR "Parents require offline compiler or validated PRECOMPILED_PARENT_SHADER_DIR")
 endif()
 file(SHA256 "${SLANGC_EXECUTABLE}" PARENT_COMPILER_HASH)
 get_filename_component(PARENT_COMPILER_PATH "${SLANGC_EXECUTABLE}" ABSOLUTE)
 set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PARENT_COMPILER_PATH}")
 execute_process(COMMAND "${SLANGC_EXECUTABLE}" -version OUTPUT_VARIABLE PARENT_VERSION ERROR_VARIABLE PARENT_VERSION_ERROR RESULT_VARIABLE PARENT_VERSION_RESULT OUTPUT_STRIP_TRAILING_WHITESPACE)
 if(NOT PARENT_VERSION_RESULT EQUAL 0)
  message(FATAL_ERROR "Parent Slang compiler version probe failed")
 endif()
 set(PARENT_PROVENANCE "compiler=${PARENT_COMPILER_PATH}\ncompiler_sha256=${PARENT_COMPILER_HASH}\nversion=${PARENT_VERSION}${PARENT_VERSION_ERROR}\nsource_sha256=${PARENT_HASH}\nparents.slang=${PARENT_HASH}\nflags=${PARENT_FLAGS}\n")
 parent_write_stable("${PARENT_IDENTITY}" "mode=compiler\n${PARENT_PROVENANCE}")
endif()
parent_write_stable("${PARENT_PENDING_PROVENANCE}" "${PARENT_PROVENANCE}")
parent_write_stable("${PARENT_PENDING_SOURCE}" "${PARENT_HASH}\n")
set(PARENT_ENTRIES parents_init parents_hook parents_flatten parents_validate parents_scan parents_offsets parents_pixels parents_labels parents_records)
set(PARENT_SPIRV)
foreach(ENTRY IN LISTS PARENT_ENTRIES)
 set(OUTPUT "${PARENT_SHADER_DIR}/${ENTRY}.spv")
 if(PRECOMPILED_PARENT_SHADER_DIR)
  file(SHA256 "${PRECOMPILED_PARENT_SHADER_DIR}/${ENTRY}.spv" PARENT_ACTUAL_SPIRV)
  file(READ "${PRECOMPILED_PARENT_SHADER_DIR}/${ENTRY}.spv.sha256" PARENT_EXPECTED_SPIRV)
  if(NOT PARENT_EXPECTED_SPIRV STREQUAL "${PARENT_ACTUAL_SPIRV}  ${ENTRY}.spv\n")
   message(FATAL_ERROR "Offline parent source or SPIR-V digest mismatch: ${ENTRY}")
  endif()
  configure_file("${PRECOMPILED_PARENT_SHADER_DIR}/${ENTRY}.spv" "${OUTPUT}" COPYONLY)
  configure_file("${PRECOMPILED_PARENT_SHADER_DIR}/${ENTRY}.spv.sha256" "${OUTPUT}.sha256" COPYONLY)
 else()
  add_custom_command(OUTPUT "${OUTPUT}" "${OUTPUT}.sha256"
   COMMAND "${SLANGC_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/shaders/parents.slang" -entry "${ENTRY}" -stage compute -target spirv -profile sm_6_0 -fp-mode precise -O2 -o "${OUTPUT}"
   COMMAND "${CMAKE_COMMAND}" "-DSPIRV=${OUTPUT}" -P "${CMAKE_CURRENT_SOURCE_DIR}/shaders/hash_shader.cmake"
   DEPENDS shaders/parents.slang shaders/hash_shader.cmake "${PARENT_IDENTITY}" "${PARENT_COMPILER_PATH}" VERBATIM)
 endif()
 list(APPEND PARENT_SPIRV "${OUTPUT}" "${OUTPUT}.sha256")
endforeach()
# Publish provenance only after every binary and digest matches this identity.
# The internal mode stamp forces offline -> compiler transitions to rebuild,
# even when the offline cache copied newer binary mtimes into this directory.
add_custom_command(OUTPUT "${PARENT_SHADER_DIR}/provenance.txt" "${PARENT_SHADER_DIR}/source.sha256"
 COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${PARENT_PENDING_PROVENANCE}" "${PARENT_SHADER_DIR}/provenance.txt"
 COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${PARENT_PENDING_SOURCE}" "${PARENT_SHADER_DIR}/source.sha256"
 DEPENDS ${PARENT_SPIRV} "${PARENT_IDENTITY}" "${PARENT_PENDING_PROVENANCE}" "${PARENT_PENDING_SOURCE}" VERBATIM)
add_custom_target(parent_spirv DEPENDS ${PARENT_SPIRV} "${PARENT_SHADER_DIR}/provenance.txt" "${PARENT_SHADER_DIR}/source.sha256")
add_library(resident_parents SHARED src/parents.cpp)
target_compile_features(resident_parents PUBLIC cxx_std_17)
target_compile_options(resident_parents PRIVATE -Wall -Wextra -Wno-missing-field-initializers)
target_link_libraries(resident_parents PUBLIC resident_rgbd)
add_dependencies(resident_parents parent_spirv)
# Synthetic API definitions replace the Vulkan loader; no Context/device/GPU.
add_executable(parent_preparation_contract test/parent_preparation_contract.cpp src/parents.cpp src/frame_pool.cpp)
target_compile_features(parent_preparation_contract PRIVATE cxx_std_17)
get_target_property(PARENT_VULKAN_INCLUDES Vulkan::Vulkan INTERFACE_INCLUDE_DIRECTORIES)
target_include_directories(parent_preparation_contract PRIVATE include ${PARENT_VULKAN_INCLUDES})
target_compile_options(parent_preparation_contract PRIVATE -UNDEBUG)
add_dependencies(parent_preparation_contract parent_spirv)
if(BUILD_TESTING)
 add_test(NAME resident_parent_host_contract COMMAND parent_preparation_contract "${PARENT_SHADER_DIR}")
endif()
install(TARGETS resident_parents EXPORT resident_rgbd_targets LIBRARY DESTINATION lib)
install(DIRECTORY "${PARENT_SHADER_DIR}/" DESTINATION share/${PROJECT_NAME}/parent-shaders)
install(FILES shaders/parents.slang DESTINATION share/${PROJECT_NAME}/parent-shaders)
