# Preparation-only consumer. Native and explicit software-binary64 variants.
set(OBSERVED_ENTRIES observed_clear observed_records observed_observe observed_eligible observed_close observed_finalize)
file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/shaders/observed_children.slang" OBSERVED_PARENT_HASH)
file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/shaders/soft_binary64.slang" OBSERVED_HELPER_HASH)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS shaders/observed_children.slang shaders/soft_binary64.slang)
set(PRECOMPILED_OBSERVED_CHILDREN_SHADER_DIR "" CACHE PATH "Hash-validated native FP64 observed membership shaders")
set(PRECOMPILED_SOFTWARE_OBSERVED_CHILDREN_SHADER_DIR "" CACHE PATH "Hash-validated software binary64 observed membership shaders")
function(observed_write_stable PATH CONTENT)
 if(EXISTS "${PATH}")
  file(READ "${PATH}" PREVIOUS)
  if(PREVIOUS STREQUAL CONTENT)
   return()
  endif()
 endif()
 file(WRITE "${PATH}" "${CONTENT}")
endfunction()
foreach(MODE native software)
 set(DIR "${CMAKE_CURRENT_BINARY_DIR}/observed-children-shaders/${MODE}")
 file(MAKE_DIRECTORY "${DIR}")
 set(DEFINES "")
 set(OBSERVED_CACHE_DIR "${PRECOMPILED_OBSERVED_CHILDREN_SHADER_DIR}")
 if(MODE STREQUAL software)
  set(DEFINES -DOBSERVED_SOFTWARE64=1)
  set(OBSERVED_CACHE_DIR "${PRECOMPILED_SOFTWARE_OBSERVED_CHILDREN_SHADER_DIR}")
 endif()
 set(FLAGS "${DEFINES} -entry <entry> -stage compute -target spirv -profile sm_6_0 -fp-mode precise -O2")
 string(SHA256 SOURCE_HASH "observed_children.slang=${OBSERVED_PARENT_HASH}\nsoft_binary64.slang=${OBSERVED_HELPER_HASH}\nmode=${MODE}\nflags=${FLAGS}\n")
 string(TOUPPER "${MODE}" UPPER_MODE)
 set(OBSERVED_${UPPER_MODE}_HASH "${SOURCE_HASH}")
 set(IDENTITY "${DIR}/build-identity.txt")
 if(OBSERVED_CACHE_DIR)
  file(READ "${OBSERVED_CACHE_DIR}/source.sha256" EXPECTED_SOURCE)
  file(READ "${OBSERVED_CACHE_DIR}/provenance.txt" PROVENANCE)
  if(NOT EXPECTED_SOURCE STREQUAL "${SOURCE_HASH}\n")
   message(FATAL_ERROR "Observed offline transitive source/mode/flags mismatch")
  endif()
  foreach(REQUIRED "source_sha256=${SOURCE_HASH}\n" "flags=${FLAGS}\n" "mode=${MODE}\n" "compiler=" "compiler_sha256=" "version=")
   string(FIND "${PROVENANCE}" "${REQUIRED}" POSITION)
   if(POSITION EQUAL -1)
    message(FATAL_ERROR "Observed offline provenance mismatch: ${REQUIRED}")
   endif()
  endforeach()
  observed_write_stable("${IDENTITY}" "mode=offline\ncache=${OBSERVED_CACHE_DIR}\n${PROVENANCE}")
 else()
  if(NOT EXISTS "${SLANGC_EXECUTABLE}")
   message(FATAL_ERROR "Observed shaders require offline compiler or validated cache")
  endif()
  file(SHA256 "${SLANGC_EXECUTABLE}" COMPILER_HASH)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${SLANGC_EXECUTABLE}")
  execute_process(COMMAND "${SLANGC_EXECUTABLE}" -version OUTPUT_VARIABLE VERSION ERROR_VARIABLE VERSION_ERROR RESULT_VARIABLE RESULT OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT RESULT EQUAL 0)
   message(FATAL_ERROR "Observed compiler version probe failed")
  endif()
  set(PROVENANCE "compiler=${SLANGC_EXECUTABLE}\ncompiler_sha256=${COMPILER_HASH}\nversion=${VERSION}${VERSION_ERROR}\nsource_sha256=${SOURCE_HASH}\nmode=${MODE}\nflags=${FLAGS}\n")
  observed_write_stable("${IDENTITY}" "mode=compiler\n${PROVENANCE}")
 endif()
 observed_write_stable("${DIR}/source.pending" "${SOURCE_HASH}\n")
 observed_write_stable("${DIR}/provenance.pending" "${PROVENANCE}")
 set(OUTPUTS "")
 foreach(ENTRY IN LISTS OBSERVED_ENTRIES)
  set(OUTPUT "${DIR}/${ENTRY}.spv")
  if(OBSERVED_CACHE_DIR)
   file(SHA256 "${OBSERVED_CACHE_DIR}/${ENTRY}.spv" ACTUAL)
   file(READ "${OBSERVED_CACHE_DIR}/${ENTRY}.spv.sha256" EXPECTED)
   if(NOT EXPECTED STREQUAL "${ACTUAL}  ${ENTRY}.spv\n")
    message(FATAL_ERROR "Observed offline SPIR-V digest mismatch")
   endif()
   add_custom_command(OUTPUT "${OUTPUT}" "${OUTPUT}.sha256" COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OBSERVED_CACHE_DIR}/${ENTRY}.spv" "${OUTPUT}" COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OBSERVED_CACHE_DIR}/${ENTRY}.spv.sha256" "${OUTPUT}.sha256" DEPENDS "${OBSERVED_CACHE_DIR}/${ENTRY}.spv" "${OBSERVED_CACHE_DIR}/${ENTRY}.spv.sha256" "${IDENTITY}" VERBATIM)
  else()
   add_custom_command(OUTPUT "${OUTPUT}" "${OUTPUT}.sha256"
    COMMAND "${SLANGC_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/shaders/observed_children.slang" ${DEFINES} -entry "${ENTRY}" -stage compute -target spirv -profile sm_6_0 -fp-mode precise -O2 -o "${OUTPUT}"
    COMMAND "${CMAKE_COMMAND}" "-DSPIRV=${OUTPUT}" -P "${CMAKE_CURRENT_SOURCE_DIR}/shaders/hash_shader.cmake"
    DEPENDS shaders/observed_children.slang shaders/soft_binary64.slang shaders/hash_shader.cmake "${SLANGC_EXECUTABLE}" "${IDENTITY}" VERBATIM)
  endif()
  list(APPEND OUTPUTS "${OUTPUT}" "${OUTPUT}.sha256")
 endforeach()
 add_custom_command(OUTPUT "${DIR}/source.sha256" "${DIR}/provenance.txt" COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${DIR}/source.pending" "${DIR}/source.sha256" COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${DIR}/provenance.pending" "${DIR}/provenance.txt" DEPENDS ${OUTPUTS} "${DIR}/source.pending" "${DIR}/provenance.pending" VERBATIM)
 add_custom_target(observed_children_${MODE}_spirv DEPENDS ${OUTPUTS} "${DIR}/source.sha256" "${DIR}/provenance.txt")
 install(DIRECTORY "${DIR}/" DESTINATION share/${PROJECT_NAME}/observed-children-shaders/${MODE} FILES_MATCHING PATTERN "*.spv" PATTERN "*.sha256" PATTERN "provenance.txt")
endforeach()
