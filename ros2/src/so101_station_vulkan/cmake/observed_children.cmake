 add_test(NAME resident_observed_children_host_contract COMMAND observed_children_host_contract "${PARENT_SHADER_DIR}" "${CHILD_SHADER_DIR}" "${GEOMETRY_SHADER_DIR}" "${CMAKE_CURRENT_BINARY_DIR}/observed-children-shaders/native")
