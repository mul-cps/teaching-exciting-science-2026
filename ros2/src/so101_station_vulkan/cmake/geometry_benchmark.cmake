# Explicit preparation-only resident-source microbenchmark. Never a GPU CTest.
set(GEOMETRY_BENCHMARK_SOURCES test/benchmark_geometry.cpp src/geometry.cpp src/frame_pool.cpp src/vulkan_context.cpp include/so101_station_vulkan/geometry.hpp include/so101_station_vulkan/pipeline.hpp shaders/geometry.slang shaders/geometry_soft.slang shaders/soft_binary64.slang)
string(TOUPPER "${CMAKE_BUILD_TYPE}" GEOMETRY_BENCHMARK_CONFIG)
set(GEOMETRY_BENCHMARK_PROVENANCE "scope=repeated-resident-preparation-only\ncompiler=${CMAKE_CXX_COMPILER}\ncompiler_version=${CMAKE_CXX_COMPILER_VERSION}\nconfiguration=${CMAKE_BUILD_TYPE}\nflags=${CMAKE_CXX_FLAGS} ${CMAKE_CXX_FLAGS_${GEOMETRY_BENCHMARK_CONFIG}} -ffp-contract=off -fno-fast-math -frounding-math\n")
foreach(SOURCE IN LISTS GEOMETRY_BENCHMARK_SOURCES)
 file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/${SOURCE}" SOURCE_HASH)
 string(APPEND GEOMETRY_BENCHMARK_PROVENANCE "${SOURCE}=${SOURCE_HASH}\n")
 set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/${SOURCE}")
endforeach()
file(SHA256 "${CMAKE_CXX_COMPILER}" GEOMETRY_BENCHMARK_COMPILER_HASH)
string(APPEND GEOMETRY_BENCHMARK_PROVENANCE "compiler_sha256=${GEOMETRY_BENCHMARK_COMPILER_HASH}\n")
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/geometry-benchmark-build.hpp" CONTENT "#pragma once\n#define GEOMETRY_BENCHMARK_PROVENANCE R\"gbm(${GEOMETRY_BENCHMARK_PROVENANCE})gbm\"\n")
add_executable(benchmark_geometry test/benchmark_geometry.cpp)
target_compile_features(benchmark_geometry PRIVATE cxx_std_17)
target_include_directories(benchmark_geometry PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
target_compile_definitions(benchmark_geometry PRIVATE GEOMETRY_BENCHMARK_BUILD_HEADER)
target_compile_options(benchmark_geometry PRIVATE -Wall -Wextra -Wno-missing-field-initializers -ffp-contract=off -fno-fast-math -frounding-math)
target_link_libraries(benchmark_geometry PRIVATE resident_geometry)
