# Depth-child preparation only; no accepted-object or closing stage.
set(CHILD_SHADER_DIR "${CMAKE_CURRENT_BINARY_DIR}/child-shaders")
set(PRECOMPILED_CHILD_SHADER_DIR "" CACHE PATH "Hash-validated offline U32/F32 child preparation SPIR-V")
file(MAKE_DIRECTORY "${CHILD_SHADER_DIR}")
# Preserve mtimes when identity is unchanged: reconfiguration is not compilation.
function(child_write_stable PATH CONTENT)
 if(EXISTS "${PATH}")
  file(READ "${PATH}" PREVIOUS)
  if(PREVIOUS STREQUAL CONTENT)
   return()
  endif()
 endif()
 file(WRITE "${PATH}" "${CONTENT}")
endfunction()
set(CHILD_IDENTITY "${CMAKE_CURRENT_BINARY_DIR}/child-build-identity.txt")
set(CHILD_PENDING_PROVENANCE "${CMAKE_CURRENT_BINARY_DIR}/child-provenance.pending")
set(CHILD_PENDING_SOURCE "${CMAKE_CURRENT_BINARY_DIR}/child-source.pending")
file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/shaders/children.slang" CHILD_HASH)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/shaders/children.slang")
set(CHILD_FLAGS "-entry <entry> -stage compute -target spirv -profile sm_6_0 -fp-mode precise -O2")
if(PRECOMPILED_CHILD_SHADER_DIR)
 file(READ "${PRECOMPILED_CHILD_SHADER_DIR}/source.sha256" CHILD_EXPECTED_SOURCE)
 file(READ "${PRECOMPILED_CHILD_SHADER_DIR}/provenance.txt" CHILD_PROVENANCE)
 if(NOT CHILD_EXPECTED_SOURCE STREQUAL "${CHILD_HASH}\n")
  message(FATAL_ERROR "Offline child source or SPIR-V digest mismatch")
 endif()
 foreach(REQUIRED_LINE "source_sha256=${CHILD_HASH}\n" "children.slang=${CHILD_HASH}\n" "flags=${CHILD_FLAGS}\n" "compiler=" "version=" "compiler_sha256=")
  string(FIND "${CHILD_PROVENANCE}" "${REQUIRED_LINE}" CHILD_POSITION)
  if(CHILD_POSITION EQUAL -1)
   message(FATAL_ERROR "Offline child missing matching provenance: ${REQUIRED_LINE}")
  endif()
 endforeach()
 file(SHA256 "${PRECOMPILED_CHILD_SHADER_DIR}/provenance.txt" CHILD_CACHE_PROVENANCE_HASH)
 child_write_stable("${CHILD_IDENTITY}" "mode=offline
cache=${PRECOMPILED_CHILD_SHADER_DIR}
provenance_sha256=${CHILD_CACHE_PROVENANCE_HASH}
${CHILD_PROVENANCE}")
else()
 if(NOT EXISTS "${SLANGC_EXECUTABLE}")
  message(FATAL_ERROR "Parents require offline compiler or validated PRECOMPILED_CHILD_SHADER_DIR")
 endif()
 file(SHA256 "${SLANGC_EXECUTABLE}" CHILD_COMPILER_HASH)
 get_filename_component(CHILD_COMPILER_PATH "${SLANGC_EXECUTABLE}" ABSOLUTE)
 set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CHILD_COMPILER_PATH}")
 execute_process(COMMAND "${SLANGC_EXECUTABLE}" -version OUTPUT_VARIABLE CHILD_VERSION ERROR_VARIABLE CHILD_VERSION_ERROR RESULT_VARIABLE CHILD_VERSION_RESULT OUTPUT_STRIP_TRAILING_WHITESPACE)
 if(NOT CHILD_VERSION_RESULT EQUAL 0)
  message(FATAL_ERROR "Parent Slang compiler version probe failed")
 endif()
 set(CHILD_PROVENANCE "compiler=${CHILD_COMPILER_PATH}\ncompiler_sha256=${CHILD_COMPILER_HASH}\nversion=${CHILD_VERSION}${CHILD_VERSION_ERROR}\nsource_sha256=${CHILD_HASH}\nchildren.slang=${CHILD_HASH}\nflags=${CHILD_FLAGS}\n")
 child_write_stable("${CHILD_IDENTITY}" "mode=compiler\n${CHILD_PROVENANCE}")
endif()
child_write_stable("${CHILD_PENDING_PROVENANCE}" "${CHILD_PROVENANCE}")
child_write_stable("${CHILD_PENDING_SOURCE}" "${CHILD_HASH}\n")
set(CHILD_ENTRIES child_lookup child_init child_hook child_jump child_validate child_reduce child_gather child_radix_hist child_radix_offsets child_radix_scatter child_scatter child_pack_scan child_pack_offsets child_jobs child_packed_init child_fill_hook child_fill_jump child_fill_validate child_boundary child_support child_finalize)
set(CHILD_SPIRV)
foreach(ENTRY IN LISTS CHILD_ENTRIES)
 set(OUTPUT "${CHILD_SHADER_DIR}/${ENTRY}.spv")
 if(PRECOMPILED_CHILD_SHADER_DIR)
  file(SHA256 "${PRECOMPILED_CHILD_SHADER_DIR}/${ENTRY}.spv" CHILD_ACTUAL_SPIRV)
  file(READ "${PRECOMPILED_CHILD_SHADER_DIR}/${ENTRY}.spv.sha256" CHILD_EXPECTED_SPIRV)
  if(NOT CHILD_EXPECTED_SPIRV STREQUAL "${CHILD_ACTUAL_SPIRV}  ${ENTRY}.spv\n")
   message(FATAL_ERROR "Offline child source or SPIR-V digest mismatch: ${ENTRY}")
  endif()
  configure_file("${PRECOMPILED_CHILD_SHADER_DIR}/${ENTRY}.spv" "${OUTPUT}" COPYONLY)
  configure_file("${PRECOMPILED_CHILD_SHADER_DIR}/${ENTRY}.spv.sha256" "${OUTPUT}.sha256" COPYONLY)
 else()
  add_custom_command(OUTPUT "${OUTPUT}" "${OUTPUT}.sha256"
   COMMAND "${SLANGC_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/shaders/children.slang" -entry "${ENTRY}" -stage compute -target spirv -profile sm_6_0 -fp-mode precise -O2 -o "${OUTPUT}"
   COMMAND "${CMAKE_COMMAND}" "-DSPIRV=${OUTPUT}" -P "${CMAKE_CURRENT_SOURCE_DIR}/shaders/hash_shader.cmake"
   DEPENDS shaders/children.slang shaders/hash_shader.cmake "${CHILD_IDENTITY}" "${CHILD_COMPILER_PATH}" VERBATIM)
 endif()
 list(APPEND CHILD_SPIRV "${OUTPUT}" "${OUTPUT}.sha256")
endforeach()
# Publish provenance only after every binary and digest matches this identity.
# The internal mode stamp forces offline -> compiler transitions to rebuild,
# even when the offline cache copied newer binary mtimes into this directory.
add_custom_command(OUTPUT "${CHILD_SHADER_DIR}/provenance.txt" "${CHILD_SHADER_DIR}/source.sha256"
 COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${CHILD_PENDING_PROVENANCE}" "${CHILD_SHADER_DIR}/provenance.txt"
 COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${CHILD_PENDING_SOURCE}" "${CHILD_SHADER_DIR}/source.sha256"
 DEPENDS ${CHILD_SPIRV} "${CHILD_IDENTITY}" "${CHILD_PENDING_PROVENANCE}" "${CHILD_PENDING_SOURCE}" VERBATIM)
add_custom_target(child_spirv DEPENDS ${CHILD_SPIRV} "${CHILD_SHADER_DIR}/provenance.txt" "${CHILD_SHADER_DIR}/source.sha256")
add_library(resident_children SHARED src/children.cpp)
target_compile_features(resident_children PUBLIC cxx_std_17)
target_compile_options(resident_children PRIVATE -Wall -Wextra -Wno-missing-field-initializers -ffp-contract=off)
target_link_libraries(resident_children PUBLIC resident_parents)
add_dependencies(resident_children child_spirv)
# Actual child+parent host paths with a synthetic Vulkan ABI, never a loader.
add_executable(child_preparation_contract test/child_preparation_contract.cpp src/children.cpp src/parents.cpp src/frame_pool.cpp)
target_compile_features(child_preparation_contract PRIVATE cxx_std_17)
get_target_property(CHILD_VULKAN_INCLUDES Vulkan::Vulkan INTERFACE_INCLUDE_DIRECTORIES)
target_include_directories(child_preparation_contract PRIVATE include ${CHILD_VULKAN_INCLUDES})
target_compile_options(child_preparation_contract PRIVATE -UNDEBUG -ffp-contract=off)
add_dependencies(child_preparation_contract child_spirv parent_spirv)
if(BUILD_TESTING)
 add_test(NAME resident_child_host_contract COMMAND child_preparation_contract "${PARENT_SHADER_DIR}" "${CHILD_SHADER_DIR}")
endif()
install(TARGETS resident_children EXPORT resident_rgbd_targets LIBRARY DESTINATION lib)
install(DIRECTORY "${CHILD_SHADER_DIR}/" DESTINATION share/${PROJECT_NAME}/child-shaders)
install(FILES shaders/children.slang DESTINATION share/${PROJECT_NAME}/child-shaders)
