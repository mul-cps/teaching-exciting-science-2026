# Independent raw-depth alignment qualification; deliberately not camera-wired.
set(ALIGNMENT_SHADER_DIR "${CMAKE_CURRENT_BINARY_DIR}/alignment-shaders")
set(PRECOMPILED_ALIGNMENT_SHADER_DIR "" CACHE PATH "Hash-validated offline alignment SPIR-V")
file(MAKE_DIRECTORY "${ALIGNMENT_SHADER_DIR}")
file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/shaders/alignment.slang" ALIGNMENT_PARENT_HASH)
file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/shaders/exact_divide.slang" EXACT_DIVIDE_HASH)
string(SHA256 ALIGNMENT_HASH "alignment.slang=${ALIGNMENT_PARENT_HASH}\nexact_divide.slang=${EXACT_DIVIDE_HASH}\n")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/shaders/alignment.slang" "${CMAKE_CURRENT_SOURCE_DIR}/shaders/exact_divide.slang")
foreach(ENTRY splat finalize)
 set(OUTPUT "${ALIGNMENT_SHADER_DIR}/${ENTRY}.spv")
 if(PRECOMPILED_ALIGNMENT_SHADER_DIR)
  file(READ "${PRECOMPILED_ALIGNMENT_SHADER_DIR}/source.sha256" EXPECTED_SOURCE)
  file(SHA256 "${PRECOMPILED_ALIGNMENT_SHADER_DIR}/${ENTRY}.spv" ACTUAL_SPIRV)
  file(READ "${PRECOMPILED_ALIGNMENT_SHADER_DIR}/${ENTRY}.spv.sha256" EXPECTED_SPIRV)
  if(NOT EXPECTED_SOURCE STREQUAL "${ALIGNMENT_HASH}\n" OR NOT EXPECTED_SPIRV STREQUAL "${ACTUAL_SPIRV}  ${ENTRY}.spv\n")
   message(FATAL_ERROR "Offline alignment source or SPIR-V digest mismatch")
  endif()
  configure_file("${PRECOMPILED_ALIGNMENT_SHADER_DIR}/${ENTRY}.spv" "${OUTPUT}" COPYONLY)
  configure_file("${PRECOMPILED_ALIGNMENT_SHADER_DIR}/${ENTRY}.spv.sha256" "${OUTPUT}.sha256" COPYONLY)
 else()
  if(NOT EXISTS "${SLANGC_EXECUTABLE}")
   message(FATAL_ERROR "Alignment requires offline compiler or validated PRECOMPILED_ALIGNMENT_SHADER_DIR")
  endif()
  add_custom_command(OUTPUT "${OUTPUT}" "${OUTPUT}.sha256"
   COMMAND "${SLANGC_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/shaders/alignment.slang" -entry "${ENTRY}" -stage compute -target spirv -profile sm_6_0 -fp-mode precise -O2 -o "${OUTPUT}"
   COMMAND "${CMAKE_COMMAND}" "-DSPIRV=${OUTPUT}" -P "${CMAKE_CURRENT_SOURCE_DIR}/shaders/hash_shader.cmake"
   DEPENDS shaders/alignment.slang shaders/exact_divide.slang shaders/hash_shader.cmake VERBATIM)
 endif()
 list(APPEND ALIGNMENT_SPIRV "${OUTPUT}" "${OUTPUT}.sha256")
endforeach()
file(WRITE "${ALIGNMENT_SHADER_DIR}/source.sha256" "${ALIGNMENT_HASH}\n")
add_custom_target(alignment_spirv DEPENDS ${ALIGNMENT_SPIRV})
add_library(resident_alignment SHARED src/alignment.cpp src/alignment_reference.cpp)
target_compile_features(resident_alignment PUBLIC cxx_std_17)
target_compile_options(resident_alignment PRIVATE -Wall -Wextra -Wno-missing-field-initializers -ffp-contract=off)
target_link_libraries(resident_alignment PUBLIC resident_rgbd realsense2::realsense2)
add_dependencies(resident_alignment alignment_spirv)
add_executable(qualify_alignment test/alignment_oracle.cpp)
target_link_libraries(qualify_alignment resident_alignment)
target_compile_options(qualify_alignment PRIVATE -ffp-contract=off)
target_compile_definitions(qualify_alignment PRIVATE ALIGNMENT_SHADER_DIR="${ALIGNMENT_SHADER_DIR}")
if(BUILD_TESTING)
 add_test(NAME resident_alignment_sdk_oracle COMMAND qualify_alignment --cpu)
endif()
install(TARGETS resident_alignment qualify_alignment EXPORT resident_rgbd_targets LIBRARY DESTINATION lib RUNTIME DESTINATION lib/${PROJECT_NAME})
install(DIRECTORY "${ALIGNMENT_SHADER_DIR}/" DESTINATION share/${PROJECT_NAME}/alignment-shaders)
install(FILES shaders/alignment.slang shaders/exact_divide.slang DESTINATION share/${PROJECT_NAME}/alignment-shaders)
include(cmake/alignment_divide_probe.cmake)

# Camera-side typed ownership; core retains no alignment dependency.
target_sources(resident_alignment PRIVATE src/raw_capture_bridge.cpp)
if(BUILD_TESTING)
 add_executable(raw_capture_bridge_host_test test/raw_capture_bridge_host_test.cpp src/raw_capture_bridge.cpp src/frame_pool.cpp src/alignment.cpp src/alignment_reference.cpp)
 get_target_property(RAW_BRIDGE_VULKAN_INCLUDES Vulkan::Vulkan INTERFACE_INCLUDE_DIRECTORIES)
 target_include_directories(raw_capture_bridge_host_test PRIVATE include ${RAW_BRIDGE_VULKAN_INCLUDES})
 target_compile_features(raw_capture_bridge_host_test PRIVATE cxx_std_17)
 target_compile_options(raw_capture_bridge_host_test PRIVATE -ffp-contract=off)
 add_dependencies(raw_capture_bridge_host_test alignment_spirv)
 target_link_libraries(raw_capture_bridge_host_test PRIVATE realsense2::realsense2)
 add_test(NAME raw_capture_bridge_host COMMAND raw_capture_bridge_host_test "${ALIGNMENT_SHADER_DIR}")
endif()
