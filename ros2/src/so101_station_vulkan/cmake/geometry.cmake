# Preparation only; deliberately not wired into executable object admission.
set(GEOMETRY_SHADER_DIR "${CMAKE_CURRENT_BINARY_DIR}/geometry-shaders")
set(PRECOMPILED_GEOMETRY_SHADER_DIR "" CACHE PATH "Hash-validated offline FP64 geometry SPIR-V")
file(MAKE_DIRECTORY "${GEOMETRY_SHADER_DIR}")
file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/shaders/geometry.slang" GEOMETRY_HASH)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/shaders/geometry.slang")
set(GEOMETRY_ENTRIES geometry_coordinates geometry_support_scan geometry_support_offsets geometry_support_scatter geometry_valid_count)
foreach(ENTRY IN LISTS GEOMETRY_ENTRIES)
 set(OUTPUT "${GEOMETRY_SHADER_DIR}/${ENTRY}.spv")
 if(PRECOMPILED_GEOMETRY_SHADER_DIR)
  file(READ "${PRECOMPILED_GEOMETRY_SHADER_DIR}/source.sha256" EXPECTED_GEOMETRY_SOURCE)
  file(SHA256 "${PRECOMPILED_GEOMETRY_SHADER_DIR}/${ENTRY}.spv" ACTUAL_GEOMETRY_SPIRV)
  file(READ "${PRECOMPILED_GEOMETRY_SHADER_DIR}/${ENTRY}.spv.sha256" EXPECTED_GEOMETRY_SPIRV)
  if(NOT EXPECTED_GEOMETRY_SOURCE STREQUAL "${GEOMETRY_HASH}\n" OR NOT EXPECTED_GEOMETRY_SPIRV STREQUAL "${ACTUAL_GEOMETRY_SPIRV}  ${ENTRY}.spv\n")
   message(FATAL_ERROR "Offline geometry source or SPIR-V digest mismatch")
  endif()
  configure_file("${PRECOMPILED_GEOMETRY_SHADER_DIR}/${ENTRY}.spv" "${OUTPUT}" COPYONLY)
  configure_file("${PRECOMPILED_GEOMETRY_SHADER_DIR}/${ENTRY}.spv.sha256" "${OUTPUT}.sha256" COPYONLY)
 else()
  if(NOT EXISTS "${SLANGC_EXECUTABLE}")
   message(FATAL_ERROR "Geometry requires offline compiler or validated PRECOMPILED_GEOMETRY_SHADER_DIR")
  endif()
  add_custom_command(OUTPUT "${OUTPUT}" "${OUTPUT}.sha256"
   COMMAND "${SLANGC_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/shaders/geometry.slang" -entry "${ENTRY}" -stage compute -target spirv -profile sm_6_0 -fp-mode precise -O2 -o "${OUTPUT}"
   COMMAND "${CMAKE_COMMAND}" "-DSPIRV=${OUTPUT}" -P "${CMAKE_CURRENT_SOURCE_DIR}/shaders/hash_shader.cmake"
   DEPENDS shaders/geometry.slang shaders/hash_shader.cmake VERBATIM)
 endif()
 list(APPEND GEOMETRY_SPIRV "${OUTPUT}" "${OUTPUT}.sha256")
endforeach()
file(WRITE "${GEOMETRY_SHADER_DIR}/source.sha256" "${GEOMETRY_HASH}\n")
add_custom_target(geometry_spirv DEPENDS ${GEOMETRY_SPIRV})
add_library(resident_geometry SHARED src/geometry.cpp)
target_compile_features(resident_geometry PUBLIC cxx_std_17)
target_compile_options(resident_geometry PRIVATE -Wall -Wextra -Wno-missing-field-initializers -ffp-contract=off)
target_link_libraries(resident_geometry PUBLIC resident_rgbd)
add_dependencies(resident_geometry geometry_spirv)
add_executable(geometry_preparation_contract test/geometry_preparation_contract.cpp)
target_link_libraries(geometry_preparation_contract resident_geometry)
# Contract assertions must remain active in a Release build.
target_compile_options(geometry_preparation_contract PRIVATE -UNDEBUG)
if(BUILD_TESTING)
 add_test(NAME resident_geometry_host_contract COMMAND geometry_preparation_contract)
endif()
install(TARGETS resident_geometry EXPORT resident_rgbd_targets LIBRARY DESTINATION lib)
install(DIRECTORY "${GEOMETRY_SHADER_DIR}/" DESTINATION share/${PROJECT_NAME}/geometry-shaders)
install(FILES shaders/geometry.slang DESTINATION share/${PROJECT_NAME}/geometry-shaders)

# CPU-only scheduling/lease benchmark supplies synthetic Vulkan entry points.
# It cannot load a Vulkan driver and excludes driver/GPU timings explicitly.
if(TARGET resident_alignment)
 add_executable(preparation_host_benchmark test/preparation_host_benchmark.cpp src/alignment.cpp src/alignment_reference.cpp src/geometry.cpp src/frame_pool.cpp)
 target_compile_features(preparation_host_benchmark PRIVATE cxx_std_17)
 get_target_property(PREPARATION_VULKAN_INCLUDES Vulkan::Vulkan INTERFACE_INCLUDE_DIRECTORIES)
 target_include_directories(preparation_host_benchmark PRIVATE include ${PREPARATION_VULKAN_INCLUDES})
 target_link_libraries(preparation_host_benchmark PRIVATE realsense2::realsense2)
 target_compile_options(preparation_host_benchmark PRIVATE -ffp-contract=off)
 add_dependencies(preparation_host_benchmark alignment_spirv geometry_spirv)
 if(BUILD_TESTING)
  add_test(NAME resident_preparation_host_paths COMMAND preparation_host_benchmark "${ALIGNMENT_SHADER_DIR}" "${GEOMETRY_SHADER_DIR}")
 endif()
endif()

# Explicit diagnostic probe; never registered as an ordinary GPU CTest.
add_executable(qualify_geometry test/qualify_geometry.cpp)
target_compile_features(qualify_geometry PRIVATE cxx_std_17)
target_link_libraries(qualify_geometry resident_geometry)
target_compile_options(qualify_geometry PRIVATE -Wall -Wextra -Wno-missing-field-initializers -ffp-contract=off)
