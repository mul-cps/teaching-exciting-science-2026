Panels:
  - Class: so101_station_operator/Operations
    Name: Station operations
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: moveit_rviz_plugin/MotionPlanning
      MoveIt_Allow_Approximate_IK: true
      MoveIt_Use_Constraint_Aware_IK: true
      Velocity_Scaling_Factor: 1.0
      Acceleration_Scaling_Factor: 1.0
      Enabled: true
      Move Group Namespace: /follower
      Name: MotionPlanning
      Planning Request:
        Planning Group: manipulator
      Planning Scene Topic: /follower/monitored_planning_scene
      Robot Description: robot_description
      Value: true
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 20
      Cell Size: 0.05
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: Selected robot and board frames
      Frames:
        All Enabled: false
        base_link:
          Value: true
        gripper_frame_link:
          Value: true
        synthetic_gripper_camera_optical:
          Value: true
        charuco_board:
          Value: true
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Marker Scale: 0.04
      Update Interval: 0.1
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /follower/robot_description
      Enabled: true
      Name: Follower robot model
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Alpha: 0.9
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: RGB8
      Enabled: true
      Name: Native RGB-D surface
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.003
      Style: Points
      Topic:
        Depth: 3
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/depth/color/points
      Use Fixed Frame: true
      Value: true
    - Alpha: 0.9
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: RGB8
      Enabled: false
      Name: Diagnostic RGB-D overlay (unqualified candidate)
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.003
      Style: Points
      Topic:
        Depth: 3
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /so101_perception/diagnostic/points
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Current camera RGB
      Normalize Range: true
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/color/image_raw
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: NOMINAL Virtual Gripper Camera
      Normalize Range: true
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /so101/synthetic_gripper_camera/image_annotated
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: false
      Name: Virtual Gripper Camera raw samples (alpha means observed)
      Normalize Range: true
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /so101/synthetic_gripper_camera/image_raw
      Value: false
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Depth-backed tag centers (unqualified)
      Namespaces:
        apriltag_id0_unassociated: true
        apriltag_id0_unassociated_label: false
      Queue Size: 10
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /so101_perception/tag_observations
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: false
      Name: Sparse 1 cm surface map (toggle with native RGB-D)
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /so101_map/occupied_surface
      Value: false
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Colored brick tracks
      Namespaces:
        colored_objects: true
        colored_object_labels: false
      Topic:
        Depth: 3
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /so101/object_markers
      Value: true
    - Class: rviz_default_plugins/PoseArray
      Enabled: true
      Name: Brick contact poses (on measured objects)
      Shape: Axes
      Axes Length: 0.015
      Axes Radius: 0.001
      Topic:
        Depth: 3
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /so101/grasp_contacts
      Value: true
    - Class: rviz_default_plugins/PoseArray
      Enabled: false
      Name: Pregrasp approach poses (+60 mm; not brick positions)
      Shape: Axes
      Axes Length: 0.025
      Axes Radius: 0.0015
      Topic:
        Depth: 3
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /so101/grasp_candidates
      Value: false
  Enabled: true
  Global Options:
    Background Color: 38; 42; 48
    Fixed Frame: charuco_board
    Frame Rate: 30
  Name: station_live
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 0.75
      Focal Point:
        X: 0
        Y: 0
        Z: 0.12
      Pitch: 0.15
      Yaw: 0
      Target Frame: <Fixed Frame>
